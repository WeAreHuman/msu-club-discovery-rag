# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=msu-clubs-index
PINECONE_NAMESPACE=msu-clubs

# LLM Configuration (Choose one - Groq is FREE!)
# Groq (Recommended - FREE with generous limits)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (Optional - PAID)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider: "groq" or "anthropic"
LLM_PROVIDER=groq

# Model Configuration
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# For Anthropic: claude-sonnet-4-5-20250929
LLM_MODEL=llama-3.3-70b-versatile

# Chunking Configuration
CHUNK_SIZE=300               # tokens per profile chunk
CHUNK_OVERLAP=50
CONSTITUTION_MAX_TOKENS=350  # max tokens per constitution article chunk

# Retrieval Configuration
TOP_K_RESULTS=5

# Scraper Data — path to msu_scraper/data/orgs/ directory
SCRAPER_ORGS_DIR=D:/msu_scraper/data/orgs

# ── build_clubs_table.py LLM backend (separate from main RAG LLM) ────────────
# Pick ONE provider. Leave TABLE_LLM_BASE_URL unset to fall back to Claude CLI.

# Ollama on another machine over WiFi:
# TABLE_LLM_BASE_URL=http://192.168.x.x:11434/v1
# TABLE_LLM_MODEL=qwen2.5:latest
# TABLE_LLM_API_KEY=         # leave empty — Ollama ignores the key

# Groq (free tier, fast):
# TABLE_LLM_BASE_URL=https://api.groq.com/openai/v1
# TABLE_LLM_MODEL=llama-3.1-8b-instant
# TABLE_LLM_API_KEY=gsk_your_groq_key

# LM Studio (local):
# TABLE_LLM_BASE_URL=http://localhost:1234/v1
# TABLE_LLM_MODEL=your-model-name
# TABLE_LLM_API_KEY=lm-studio

# ── LangSmith Observability (optional — app runs normally without these)
# Get your API key at https://smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=msu-club-discovery
# LANGCHAIN_TRACING_V2=true
